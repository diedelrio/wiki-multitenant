{
  "name": "development-wiki-v3",
  "private": true,
  "version": "0.4.0",
  "description": "Wiki técnica multitenant con gestión documental y control de acceso por roles.",
  "type": "module",
  "scripts": {
    "content:index": "node scripts/build-content-index.mjs",
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "build:render": "prisma generate && npm run build && npm run build:api",
    "start": "node server/dist/index.js",
    "start:render": "prisma migrate deploy && npm start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "content:import": "tsx prisma/seed.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:production": "node scripts/test-production-server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.7",
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.0.7"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
